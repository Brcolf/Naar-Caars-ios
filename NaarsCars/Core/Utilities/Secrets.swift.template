import Foundation

/// Secrets manager with XOR-based obfuscation for credentials
struct Secrets {
    // MARK: - Obfuscation Key
    private static let obfuscationKey: [UInt8] = [0x4E, 0x61, 0x61, 0x72, 0x73, 0x43, 0x61, 0x72, 0x73] // "NaarsCars"

    // MARK: - Obfuscated Credentials
    /// Replace these arrays using Scripts/obfuscate.swift output.
    private static let obfuscatedURL: [UInt8] = [
        /* TODO: paste obfuscated Supabase URL bytes */
    ]

    /// The Supabase publishable key (`sb_publishable_...`) from Project Settings > API keys.
    /// The legacy anon JWT (`eyJ...`) is no longer the expected value.
    private static let obfuscatedAnonKey: [UInt8] = [
        /* TODO: paste obfuscated Supabase publishable key bytes */
    ]

    // MARK: - Deobfuscation
    private static func deobfuscate(_ data: [UInt8]) -> String {
        var result: [UInt8] = []
        for (index, byte) in data.enumerated() {
            let keyByte = obfuscationKey[index % obfuscationKey.count]
            result.append(byte ^ keyByte)
        }
        return String(bytes: result, encoding: .utf8) ?? ""
    }

    // MARK: - Public Properties
    static var supabaseURL: String {
        return deobfuscate(obfuscatedURL)
    }

    /// Returns the Supabase publishable key (`sb_publishable_...`). The name `supabaseAnonKey`
    /// is kept for source compatibility; the legacy anon JWT is no longer the expected value.
    static var supabaseAnonKey: String {
        return deobfuscate(obfuscatedAnonKey)
    }

    // MARK: - Validation

    /// True when the obfuscated values are real credentials rather than the
    /// template placeholders. `SupabaseService.healthCheck()` and the connection
    /// tests use this; CI builds from this template, so it must stay defined here.
    static var isConfigured: Bool {
        return !supabaseURL.contains("YOUR_PROJECT") &&
               !supabaseAnonKey.contains("YOUR_ANON") &&
               !supabaseURL.isEmpty && !supabaseAnonKey.isEmpty
    }
}


