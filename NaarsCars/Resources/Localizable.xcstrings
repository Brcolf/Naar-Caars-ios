    "favor_detail_delete_claimed_confirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has offered to help with this favor. Deleting it removes it for them too, and they will not be notified, so message them first. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se ofreció a ayudar con este favor. Si lo eliminas, también se eliminará para esa persona y no se le notificará, así que envíale un mensaje primero. Esta acción no se puede deshacer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@님이 이 부탁을 돕겠다고 했습니다. 삭제하면 상대방에게서도 삭제되며 알림이 전송되지 않으므로 먼저 메시지를 보내세요. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã đề nghị giúp trong yêu cầu giúp đỡ này. Xóa yêu cầu cũng sẽ xóa nó đối với họ và họ sẽ không được thông báo, vì vậy hãy nhắn tin cho họ trước. Không thể hoàn tác thao tác này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已表示愿意协助这项帮忙。删除后对方的这一项也会被移除，并且不会收到通知，所以请先给对方发消息。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 已表示願意協助這項幫忙。刪除後對方的這一項也會被移除，而且不會收到通知，所以請先傳訊息給對方。此操作無法復原。"
          }
        }
      }
    },
