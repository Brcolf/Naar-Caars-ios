    "welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share rides, ask for help with favors, and connect with people nearby in a trusted local community."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte viajes, pide ayuda con favores y conecta con personas cercanas en una comunidad local de confianza."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 있는 지역 커뮤니티에서 라이드를 나누고, 부탁으로 도움을 요청하고, 가까운 이웃과 연결하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ chuyến đi, nhờ giúp đỡ và kết nối với những người ở gần bạn trong một cộng đồng địa phương đáng tin cậy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在值得信赖的本地社区中，分享搭车、请求帮忙，并与附近的人建立联系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在值得信賴的在地社群中，分享搭車、請求幫忙，並與附近的人建立聯繫。"
          }
        }
      }
    },
    "welcome_continue_as_guest" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
