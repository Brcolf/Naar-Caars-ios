      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off. You can still search for a place or move the map. To share where you are, turn on location access in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Aún puedes buscar un lugar o mover el mapa. Para compartir dónde estás, activa el acceso a la ubicación en Ajustes."
