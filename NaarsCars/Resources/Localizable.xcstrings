    "banned_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account has been restricted due to a violation of our community guidelines. If you believe this is an error, please contact support."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta ha sido restringida por una infracción de nuestras normas de la comunidad. Si crees que se trata de un error, comunícate con soporte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커뮤니티 가이드라인 위반으로 계정이 제한되었습니다. 오류라고 생각되시면 지원팀에 문의해 주세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tài khoản của bạn đã bị hạn chế do vi phạm nguyên tắc cộng đồng của chúng tôi. Nếu bạn cho rằng đây là nhầm lẫn, vui lòng liên hệ bộ phận hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的账户因违反社区准则而被限制。如果您认为这是误判，请联系支持团队。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的帳戶因違反社群準則而被限制。如果您認為這是誤判，請聯絡支援團隊。"
          }
        }
      }
    },
