    "guest_messages_privacy_rationale" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages are private conversations between verified community members. Create an account to start messaging your neighbors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes son conversaciones privadas entre miembros verificados de la comunidad. Crea una cuenta para comenzar a enviar mensajes a tus vecinos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지는 인증된 커뮤니티 회원 간의 비공개 대화입니다. 이웃에게 메시지를 보내려면 계정을 만드세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn là các cuộc trò chuyện riêng tư giữa các thành viên cộng đồng đã được xác minh. Hãy tạo tài khoản để bắt đầu nhắn tin cho láng giềng của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息是已验证社区成员之间的私密对话。创建账户后即可开始给邻居发消息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊息是已驗證社群成員之間的私密對話。建立帳戶後即可開始傳訊息給鄰居。"
          }
        }
      }
    },
