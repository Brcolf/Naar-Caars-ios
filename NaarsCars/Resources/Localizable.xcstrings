    "pending_review_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-up was successful and your account is now being reviewed. We review new members to help keep Naar's Cars safe and high-quality for everyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu registro fue exitoso y tu cuenta se está revisando. Revisamos a los nuevos miembros para ayudar a mantener Naar's Cars seguro y de alta calidad para todos."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가입이 완료되었으며 계정을 검토하고 있습니다. 모든 분께 안전하고 품질 높은 Naar's Cars를 제공하기 위해 신규 회원을 검토합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn đã đăng ký thành công và tài khoản của bạn hiện đang được xem xét. Chúng tôi xem xét các thành viên mới để giúp giữ cho Naar's Cars an toàn và chất lượng cho mọi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已注册成功，账户正在审核中。我们会审核新成员，以确保 Naar's Cars 对每个人都安全且高质量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已註冊成功，帳戶正在審核中。我們會審核新成員，以確保 Naar's Cars 對每個人都安全且高品質。"
          }
        }
      }
    },
