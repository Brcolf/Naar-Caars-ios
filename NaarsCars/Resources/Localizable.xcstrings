    "welcome_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone can request an account. New accounts are reviewed to help keep the community safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera puede solicitar una cuenta. Las cuentas nuevas se revisan para ayudar a mantener segura a la comunidad."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누구나 계정을 요청할 수 있습니다. 커뮤니티의 안전을 위해 새 계정은 검토를 거칩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai cũng có thể yêu cầu tạo tài khoản. Các tài khoản mới được xem xét để giúp giữ an toàn cho cộng đồng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以申请账户。新账户会经过审核，以帮助维护社区安全。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何人都可以申請帳戶。新帳戶會經過審核，以協助維護社群安全。"
          }
        }
      }
    },
