    "profile_delete_account_message" : {
      "comment" : "Body of the Delete Account alert (BannedAccountView).",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete your account including all rides, favors, messages, reviews, and Town Hall posts. Active requests you've claimed will be reopened for others. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente tu cuenta, incluidos todos los viajes, favores, mensajes, reseñas y publicaciones del Foro. Las solicitudes activas que hayas reclamado se reabrirán para otros. Esta acción no se puede deshacer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 라이드, 부탁, 메시지, 리뷰, 타운홀 게시글을 포함해 계정이 영구적으로 삭제됩니다. 수락한 진행 중인 요청은 다른 사람이 수락할 수 있도록 다시 열립니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ xóa vĩnh viễn tài khoản của bạn, bao gồm tất cả chuyến đi, nhờ vả, tin nhắn, đánh giá và bài đăng trên Diễn đàn. Các yêu cầu đang hoạt động mà bạn đã nhận sẽ được mở lại cho người khác. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除您的账户，包括所有搭车、帮忙、消息、评价和社区论坛帖子。您已认领的进行中请求将重新开放给其他人认领。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將永久刪除您的帳戶，包括所有搭車、幫忙、訊息、評價和社群論壇貼文。您已認領的進行中請求將重新開放給其他人認領。此操作無法復原。"
          }
        }
      }
    },
