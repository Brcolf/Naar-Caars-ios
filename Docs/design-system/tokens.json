  "spacing": {
    "source": "Constants.Spacing",
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "ms": 12,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radius": {
    "source": "Constants.Radius",
    "xs": 4,
    "sm": 8,
    "md": 12,
    "card": 16,
    "button": 27,
    "controls": "capsule for chips, badges and text fields; Radius.button for full-width buttons and toasts",
    "avatars": "circle"
  },
  "elevation": {
    "source": "View+Extensions.swift",
    "cardShadow": {
      "color": "black",
      "opacity": 0.06,
      "radius": 6,
      "y": 2
    },
    "floatingShadow": {
      "color": "black",
      "opacity": 0.16,
      "radius": 10,
      "y": 4
    }
  },
  "motion": {
    "source": "Animation extension in View+Extensions.swift",
    "naarsStandard": {
      "curve": "spring",
      "response": 0.3,
      "dampingFraction": 0.8
    },
    "naarsQuick": {
      "curve": "easeOut",
      "duration": 0.2
    },
    "naarsPress": {
      "curve": "spring",
      "response": 0.2,
      "dampingFraction": 0.7,
      "scale": 0.96
    }
  },
  "controlHeights": {
