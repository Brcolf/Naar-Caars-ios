{
  "meta": {
    "name": "Naar's Cars design tokens",
    "updated": "2026-10-06",
    "branch": "claude/quirky-gates-4bkmv4",
    "note": "Mirrors the tokens defined in Swift. See README.md for usage rules."
  },
  "color": {
    "source": "NaarsCars/UI/Styles/ColorTheme.swift",
    "naarsPrimary": {
      "light": "#A35944",
      "dark": "#C97A64",
      "role": "Primary buttons, tint, links, own message bubbles, selected states"
    },
    "naarsAccent": {
      "light": "#D4A574",
      "dark": "#E0B88A",
      "role": "Brand palette only; too light for text or icons"
    },
    "naarsSuccess": {
      "light": "#137A39",
      "dark": "#34D669",
      "role": "Open status, confirmations, pickup dot"
    },
    "naarsWarning": {
      "light": "#A35200",
      "dark": "#FBBF24",
      "role": "Pending status, cautions"
    },
    "naarsError": {
      "light": "#C62828",
      "dark": "#F87171",
      "role": "Errors, validation, destructive actions"
    },
    "naarsBadge": {
      "light": "#D32F2F",
      "dark": "#D32F2F",
      "role": "Unread-count badge fill"
    },
    "naarsBadgeMuted": {
      "light": "#6E6E73",
      "dark": "#6E6E73",
      "role": "Muted (silenced) count badge fill; white text stays at about 5:1"
    },
    "naarsRating": {
      "light": "#C2780A",
      "dark": "#FBBF24",
      "role": "Rating stars"
    },
    "rideAccent": {
      "light": "#1D5FD6",
      "dark": "#6EA8FF",
      "role": "Rides: card stripe, detail headers, route line, map pin"
    },
    "favorAccent": {
      "light": "#0F766E",
      "dark": "#2DD4BF",
      "role": "Favors: card stripe, detail headers, map pin"
    },
    "naarsBackground": {
      "light": "#F2F2F7",
      "dark": "#000000",
      "system": "systemGroupedBackground",
      "role": "Screen ground"
    },
    "naarsCardBackground": {
      "light": "#FFFFFF",
      "dark": "#1C1C1E",
      "system": "secondarySystemGroupedBackground",
      "role": "Cards and rows"
    },
    "naarsBackgroundSecondary": {
      "light": "#FFFFFF",
      "dark": "#1C1C1E",
      "system": "secondarySystemGroupedBackground",
      "role": "Same surface as naarsCardBackground"
    },
    "naarsInsetBackground": {
      "light": "#F2F2F7",
      "dark": "#2C2C2E",
      "system": "tertiarySystemGroupedBackground",
      "role": "Blocks nested in a card; unselected tiles and chips"
    },
    "naarsTextPrimary": {
      "system": "label",
      "role": "Same as .primary"
    },
    "naarsTextSecondary": {
      "system": "secondaryLabel",
      "role": "Same as .secondary"
    },
    "naarsTextTertiary": {
      "system": "tertiaryLabel",
      "role": "Placeholders only"
    },
    "naarsDivider": {
      "system": "separator",
      "role": "Rules"
    },
    "naarsBorder": {
      "system": "separator",
      "role": "Hairline strokes"
    },
    "naarsDisabled": {
      "system": "systemGray5",
      "role": "Fill of a disabled or non-interactive control"
    },
    "naarsDisabledContent": {
      "system": "tertiaryLabel",
      "role": "Label and stroke on a disabled control"
    },
    "naarsOverlay": {
      "light": "rgba(0,0,0,0.5)",
      "dark": "rgba(0,0,0,0.7)",
      "role": "Modal scrim"
    }
  },
  "assetCatalogColor": {
    "AccentColor": {
      "light": "#A35944",
      "dark": "#C97A64"
    },
    "LaunchBackground": {
      "light": "#FFFFFF",
      "dark": "#1C1C1E"
    }
  },
  "statusColor": {
    "open": "naarsSuccess",
    "pending": "naarsWarning",
    "confirmed": "naarsPrimary",
    "completed": "naarsTextSecondary"
  },
  "tint": {
    "chipFill": 0.12,
    "highlightedRow": 0.1,
    "unreadRow": 0.05
  },
